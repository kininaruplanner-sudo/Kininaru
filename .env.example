# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already excluded via .gitignore.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ SERVER-ONLY — never prefix this with NEXT_PUBLIC_. This key bypasses
# every RLS policy. It is currently unused by the app (see
# lib/supabase/admin.ts for why) — only set it if you add a feature that
# genuinely requires it. Get it from Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key used server-side only by app/api/chat/route.ts
# (never expose this with a NEXT_PUBLIC_ prefix)
# Get it from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional — override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — analytics (see lib/analytics.ts). Leave unset to disable
# tracking entirely (the app works fully without it). This key is safe to
# expose to the browser: it identifies your PostHog project, not a secret.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional — set to "true" to take the entire app offline behind
# app/maintenance/page.tsx (see lib/supabase/proxy.ts). Leave unset in
# normal operation.
MAINTENANCE_MODE=

# Optional — only needed if you want to force a specific redirect URL for the
# signup confirmation email in a given environment. Leave unset in production
# so the app falls back to the real deployed origin automatically.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
